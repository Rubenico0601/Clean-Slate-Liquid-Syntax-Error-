{
  "manifest_version": 3,
  "name": "CleanSlate — CleverTap Liquid Tools",
  "short_name": "CleanSlate",
  "version": "0.1.0",
  "description": "Lint, preview, and inspect CleverTap LiqP 0.7.9 templates. Convert Leanplum syntax to CleverTap.",
  "action": {
    "default_title": "Open CleanSlate with current template",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.getbee.io/*"
  ]
}
